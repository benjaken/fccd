{
  "name": "fccd",
  "version": "1.0.0",
  "description": "FCCD — Food Channel Catering Delivery operations system",
  "private": true,
  "type": "module",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run test && npm run check:edge-functions && tsc -b && vite build",
    "lint": "tsc -b --pretty false",
    "preview": "vite preview",
    "publish:branches": "npm run build && node scripts/publish-branches.mjs",
    "generate:bubble-schema": "node scripts/generate-bubble-schema.mjs",
    "generate:bubble-option-sets": "node scripts/generate-bubble-option-sets.mjs",
    "generate:file-migration-status": "node scripts/generate-file-migration-status.mjs",
    "migrate:bubble-files": "node scripts/migrate-bubble-files.mjs",
    "generate:migration-report": "node scripts/generate-core-migration-report.mjs",
    "generate:full-migration-report": "node scripts/generate-full-migration-report.mjs",
    "generate:migration-status": "node scripts/generate-migration-entity-status.mjs",
    "architecture:index": "node scripts/generate-architecture-index.mjs",
    "architecture:check": "node scripts/validate-architecture-docs.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:target": "vitest run",
    "check:edge-functions": "tsc -p supabase/functions/tsconfig.check.json --pretty false"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chifung-BWSolution/FCCD.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/chifung-BWSolution/FCCD/issues"
  },
  "homepage": "https://github.com/chifung-BWSolution/FCCD#readme",
  "dependencies": {
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.13",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/supabase-js": "^2.112.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "html2canvas": "^1.4.1",
    "i18next": "^26.3.6",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.31.0",
    "pdfjs-dist": "^4.10.38",
    "qz-tray": "^2.2.6",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
