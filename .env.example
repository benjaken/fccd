# Non-main Git branches / local / preview default to Supabase `develop`.
# Only Git `main` / Vercel production should use the `main` branch URL/key.
VITE_SUPABASE_URL=https://mxiueauyylnpwlxrvgbo.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xgNR7t263k4Jn709h2kf2Q_NKR1hwbO

# Optional: one-click sign-in for Vercel preview / local testing only.
# Credentials are baked into the client bundle — never enable on production.
# VITE_ENABLE_QUICK_LOGIN=true
# VITE_QUICK_LOGIN_EMAIL=you@example.com
# VITE_QUICK_LOGIN_PASSWORD=your-password

# Supplier quote recognition Edge Function (server-side only; never use VITE_).
# SUPPLIER_QUOTE_MAX_FILE_BYTES=52428800
# SUPPLIER_QUOTE_MAX_EXTRACTION_BYTES=300000
# SUPPLIER_QUOTE_AI_ENABLED=false
# SUPPLIER_QUOTE_AI_PROVIDER=xai
# SUPPLIER_QUOTE_AI_ENDPOINT=https://api.x.ai/v1/chat/completions
# SUPPLIER_QUOTE_AI_MODEL=grok-4.6
# XAI_API_KEY=set-with-supabase-secrets-only
# SUPPLIER_QUOTE_AI_TIMEOUT_MS=12000
# SUPPLIER_QUOTE_AI_MAX_RETRIES=1
# SUPPLIER_QUOTE_AI_MAX_INPUT_CHARS=80000
# SUPPLIER_QUOTE_AI_MAX_COST_USD=0.25

# Address translation Edge Function (server-side only; never use VITE_).
# Uses REPORT_AI endpoint/key when ADDRESS_TRANSLATION_AI_* is unset, but not
# REPORT_AI_MODEL — grok-4.6 reasoning is too slow for a one-line address.
# ADDRESS_TRANSLATION_AI_ENABLED=true
# ADDRESS_TRANSLATION_AI_PROVIDER=xai
# ADDRESS_TRANSLATION_AI_ENDPOINT=https://api.x.ai/v1/chat/completions
# ADDRESS_TRANSLATION_AI_MODEL=grok-4.3

# Report AI interpretation Edge Function (server-side only; never use VITE_).
# REPORT_AI_ENABLED=false
# REPORT_AI_PROVIDER=xai
# REPORT_AI_ENDPOINT=https://api.x.ai/v1/chat/completions
# REPORT_AI_MODEL=grok-4.6
# REPORT_AI_API_KEY=set-with-supabase-secrets-only
# REPORT_AI_TIMEOUT_MS=25000
# REPORT_AI_MAX_INPUT_CHARS=180000
# REPORT_AI_DAILY_LIMIT=100
# REPORT_AI_CACHE_HOURS=24

# Transactional email via Resend (server-side only; never use VITE_).
# RESEND_API_KEY=set-with-supabase-secrets-only
# Inventory email worker (Supabase Secrets / Vault only).
# INVENTORY_EMAIL_CRON_SECRET=must-match-vault-secret-inventory_email_cron_secret
# Vault: inventory_email_notifications_enabled=true
# Vault: inventory_email_function_url=https://<project>.supabase.co/functions/v1/inventory-email-notifications
# DAILY_SALES_EMAIL_TO=optional-test-recipient@example.com

# Asana confirmed Enquiry order sync (server-side Supabase Secrets only).
# ASANA_ACCESS_TOKEN=set-with-supabase-secrets-only
# ASANA_DEFAULT_PROJECT_GID=your-asana-project-gid
# APP_URL=https://your-admin.example.com

# WATI order notifications (server-side only; store production values in
# Supabase Secrets, never in VITE_ variables).
# WATI_API_ENDPOINT=https://live-mt-server.wati.io/your-tenant-id
# WATI_API_TOKEN=set-with-supabase-secrets-only
# WATI_CHANNEL_NUMBER=85212345678
# WATI_WEBHOOK_SECRET=set-with-supabase-secrets-only
# An optional customer-service automatic-reply allowlist is stored on
# customer_service_controls.allowed_phones; an empty array allows all callers.
# Optional dedicated grounded FAQ model. When omitted, the customer-service
# bot reuses the configured address/report AI endpoint, model, and XAI key.
# CUSTOMER_SERVICE_AI_ENABLED=true
# CUSTOMER_SERVICE_AI_ENDPOINT=https://api.x.ai/v1/chat/completions
# CUSTOMER_SERVICE_AI_MODEL=grok-4.3
# CUSTOMER_SERVICE_AI_API_KEY=set-with-supabase-secrets-only
# CUSTOMER_SERVICE_AI_TIMEOUT_MS=12000
# WATI_ORDER_CRON_SECRET=must-match-vault-secret-wati_order_cron_secret
# WATI_SHOP_NAME=Food Channels Catering
# WATI_NOTIFICATIONS_ACTIVATE_AT=2026-08-31T00:00:00+08:00
# Emergency overrides; set false to force-disable regardless of the in-app setting.
# WATI_AUTOMATIC_NOTIFICATIONS_ENABLED=true
# EMAIL_AUTOMATIC_NOTIFICATIONS_ENABLED=true
# WATI_MANUAL_ORDER_CONFIRMATION_ENABLED=true
# EMAIL_MANUAL_ORDER_CONFIRMATION_ENABLED=true
# WATI_ADD_ON_LINK=https://example.com/add-ons
# WATI_ORDER_CONFIRMATION_TEMPLATE_NAME=order_confirm_with_action
# WATI_ORDER_CONFIRMATION_ADDON_TEMPLATE_NAME=order_confirm_with_action_and_aolink
# PayPal add-on checkout (server-side Supabase Secrets; default is sandbox).
# PAYPAL_ENVIRONMENT=sandbox
# PAYPAL_CLIENT_ID=set-with-supabase-secrets-only
# PAYPAL_CLIENT_SECRET=set-with-supabase-secrets-only
# PAYPAL_WEBHOOK_ID=set-with-supabase-secrets-only
# SELF_SERVICE_PUBLIC_URL=https://www.foodchannels-delivery.com
# ORDER_ADMIN_BASE_URL=https://your-admin.example.com
# DRIVER_ASSIGNMENT_REMINDER_HOUR_HK=9
# DRIVER_ASSIGNMENT_REMINDER_INTERVAL_HOURS=3
# WATI_FACTORY_UNSENT_TEMPLATE_NAME=factory_unsent_internal_reminder
# WATI_FACTORY_UNSENT_BROADCAST_NAME=Factory unsent internal reminder
# WATI_ORDER_RECONCILIATION_MISSING_TEMPLATE_NAME=fccd_internal_missing_order
# WATI_ORDER_RECONCILIATION_MISSING_BROADCAST_NAME=FCCD internal missing order
# WATI_ORDER_RECONCILIATION_FACTORY_UNSENT_TEMPLATE_NAME=fccd_internal_factory_unsent
# WATI_ORDER_RECONCILIATION_FACTORY_UNSENT_BROADCAST_NAME=FCCD internal factory unsent
# WATI_ORDER_RECONCILIATION_CLEAR_TEMPLATE_NAME=fccd_internal_order_audit_clear
# WATI_ORDER_RECONCILIATION_CLEAR_BROADCAST_NAME=Internal order audit clear
# WATI_ORDER_RECONCILIATION_URGENT_TEMPLATE_NAME=fccd_internal_missing_order_6h_urgent
# WATI_ORDER_RECONCILIATION_URGENT_BROADCAST_NAME=Internal missing order urgent
# Daily per-order readiness template parameters: brand_name, order_number,
# customer_name, delivery_date, delivery_time, issue_summary, order_link.
# WATI_ORDER_READINESS_ISSUE_TEMPLATE_NAME=fccd_internal_order_readiness_issue
# WATI_ORDER_READINESS_ISSUE_BROADCAST_NAME=Internal order readiness issue
# WATI_DRIVER_ASSIGNMENT_REMINDER_TEMPLATE_NAME=fccd_driver_assign_reminder_v1
# WATI_DRIVER_ASSIGNMENT_REMINDER_BROADCAST_NAME=fccd_driver_assign_reminder_v1
